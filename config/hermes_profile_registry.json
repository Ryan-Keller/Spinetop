{
  "schema_version": "1.0",
  "notes": [
    "Repo-local mapping between Spinetop roles and Hermes Agent profile homes.",
    "This registry does not change governance behavior or start Hermes by itself.",
    "Activation controls point back to the existing runtime files so the repo keeps one source of truth."
  ],
  "bootstrap": {
    "runtime_root": "services/hermes/runtime/profiles",
    "template_root": "services/hermes/roles",
    "recommended_environment": "WSL2 or Linux",
    "install_script": "scripts/install_hermes_agent.sh",
    "management_script": "scripts/bootstrap_hermes_profiles.py"
  },
  "profiles": [
    {
      "profile_name": "spinetop-sentinel",
      "display_name": "Spinetop-Sentinel",
      "role_purpose": "Internal reviewer/watch/anomaly role for bounded operational review.",
      "role_config_ref": "config/sentinel_role.json",
      "template_root": "services/hermes/roles/spinetop-sentinel",
      "runtime_home": "services/hermes/runtime/profiles/spinetop-sentinel/home",
      "config_root": "services/hermes/runtime/profiles/spinetop-sentinel/home",
      "memory_root": "services/hermes/runtime/profiles/spinetop-sentinel/home/memories",
      "memory_ref": "config/sentinel_role.json#memory_refs",
      "soul_path": "services/hermes/roles/spinetop-sentinel/SOUL.md",
      "activation": {
        "default_state": "active",
        "control_ref": "config/hermes_runtime.json#runtime_state.active",
        "inactive_mode_ref": "config/hermes_runtime.json#runtime_state.inactive_mode",
        "disabled_safe_contract_ref": "config/sentinel_role.json#runtime_behavior.inactive_behavior"
      },
      "model_provider_slot": {
        "provider_ref": "config/hermes_runtime.json#provider_profiles.ollama",
        "model_key_ref": "config/hermes_runtime.json#default_model_key",
        "provider_requirement": "local_only"
      },
      "separation": {
        "shared_identity_allowed": false,
        "shared_memory_allowed": false,
        "shared_runtime_home_allowed": false
      }
    },
    {
      "profile_name": "spinetop-expeditioner",
